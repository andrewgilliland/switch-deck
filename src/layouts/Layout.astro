---
interface Props {
  title?: string;
  mode?: "default" | "deck";
  stylesheet?: string;
}

const { title = "Switch Deck", mode = "default", stylesheet } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {stylesheet && <link rel="stylesheet" href={stylesheet} />}
  </head>
  <body data-layout={mode}>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  body[data-layout="deck"] {
    overflow: hidden;
    background: #080a0b;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  :focus-visible {
    outline: 3px solid #159a8d;
    outline-offset: 3px;
  }
</style>
