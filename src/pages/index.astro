---
import { ArrowUpRight, Gamepad2 } from "@lucide/astro";
import Layout from "../layouts/Layout.astro";

import { getDecks } from "../lib/decks";

const decks = await getDecks();
---

<Layout title="Switch Deck">
  <main class="catalog">
    <header class="catalog-header">
      <div class="brand-mark"><Gamepad2 size={28} aria-hidden="true" /></div>
      <p class="eyebrow">Switch Deck</p>
      <h1>Presentation library</h1>
    </header>

    <section class="deck-list" aria-label="Deck Catalog">
      {
        decks.map((deck, index) => (
          <a href={`/${deck.slug}`} class="deck-row">
            <span class="deck-number">
              {String(index + 1).padStart(2, "0")}
            </span>
            <span class="deck-copy">
              <strong>{deck.metadata.data.title}</strong>
              <span>{deck.metadata.data.description}</span>
            </span>
            <span class="slide-count">{deck.slides.length} Slides</span>
            <ArrowUpRight aria-hidden="true" />
          </a>
        ))
      }
    </section>
  </main>
</Layout>

<style>
  .catalog {
    min-height: 100dvh;
    box-sizing: border-box;
    padding: 4rem max(1.5rem, calc((100vw - 72rem) / 2));
    background:
      repeating-linear-gradient(
        90deg,
        transparent 0 95px,
        rgb(17 22 25 / 5%) 95px 96px
      ),
      #f4f0e8;
    color: #111619;
    font-family: "Avenir Next", "Gill Sans", sans-serif;
  }

  .catalog-header {
    margin-bottom: 5rem;
  }

  .brand-mark {
    display: grid;
    width: 3rem;
    height: 3rem;
    margin-bottom: 2rem;
    place-items: center;
    background: #e84b32;
    color: white;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: #167f76;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1 {
    max-width: 12ch;
    margin: 0;
    font-family: "Iowan Old Style", "Palatino Linotype", serif;
    font-size: 4rem;
    letter-spacing: 0;
    line-height: 0.98;
  }

  .deck-list {
    border-top: 2px solid #111619;
  }

  .deck-row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto 1.5rem;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgb(17 22 25 / 24%);
    color: inherit;
    text-decoration: none;
  }

  .deck-row:hover strong,
  .deck-row:focus-visible strong {
    color: #d73f28;
  }
  .deck-number,
  .slide-count {
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    text-transform: uppercase;
  }
  .deck-copy {
    display: grid;
    gap: 0.35rem;
  }

  .deck-copy strong {
    font-family: "Iowan Old Style", "Palatino Linotype", serif;
    font-size: 1.75rem;
    letter-spacing: 0;
    transition: color 140ms ease;
  }

  .deck-copy span {
    color: #4f5659;
  }

  @media (max-width: 640px) {
    .catalog {
      padding-top: 2rem;
    }
    .catalog-header {
      margin-bottom: 3rem;
    }
    h1 {
      font-size: 2.75rem;
    }
    .deck-row {
      grid-template-columns: 2rem minmax(0, 1fr) 1.5rem;
    }
    .slide-count {
      display: none;
    }
  }
</style>
